# ---------- Backend environment variables (placeholders only: never commit real values) ----------
# Copy to ".env" for LOCAL development. On Railway set these in the service "Variables" tab.

NODE_ENV=production
# Railway sets PORT automatically. Do not set it on Railway.
PORT=5000

# Secret used to sign login tokens. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Netlify site URL(s) allowed to call this API (comma separated, no trailing slash)
FRONTEND_URL=https://your-site-name.netlify.app

# Set to true ONLY if you want anyone to be able to create cashier accounts. Default: admins only.
ALLOW_PUBLIC_REGISTRATION=false

# ---------- Database (MySQL) ----------
# On Railway, reference the MySQL service variables instead of typing values:
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# ...or for local development use individual values instead of MYSQL_URL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your-local-mysql-password
# DB_NAME=cosmetics_pos

# Only if your MySQL provider requires TLS (Railway's does not):
# DB_SSL=true

# Used only by `npm run create-admin` (run once, then delete these from the environment)
# ADMIN_NAME=Shop Owner
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=choose-a-long-password
